<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://orgStructureEmployeeListView.title"
      focusComponent="orgStructureEmployeesDataGrid">
    <data>
        <collection id="orgStructureEmployeesDc"
                    class="uz.kapitalbank.umida.entity.OrgStructureEmployee">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="orgStructureEmployeesDl" readOnly="true">
                <query>
                    <![CDATA[
                        select e from OrgStructureEmployee e
                        order by e.fullname
                    ]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <dataGrid id="orgStructureEmployeesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="orgStructureEmployeesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="readAction" type="list_read"/>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="fullname"/>
                <column property="email"/>
                <column property="user"/>
                <column property="positionName"/>
                <column property="organization"/>
                <column property="department"/>
                <column property="division"/>
                <column property="sectionName"/>
                <column property="unit"/>
            </columns>
        </dataGrid>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="orgStructureEmployeesDataGrid.createAction"/>
            <button id="editButton" action="orgStructureEmployeesDataGrid.editAction"/>
            <button id="removeButton" action="orgStructureEmployeesDataGrid.removeAction"/>
            <endSlot>
                <simplePagination id="pagination" dataLoader="orgStructureEmployeesDl"/>
            </endSlot>
        </hbox>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
