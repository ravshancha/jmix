<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
    Расширение экрана отчёта из аддона: к вкладке «Отчёт» добавляется только поле «Домен», всё
    остальное берётся из io/jmix/reportsflowui/view/report/report-detail-view.xml.

    messagesGroup оставлен аддоновским, чтобы унаследованные msg:// ключи продолжали
    разрешаться; собственная подпись поля берётся по полному ключу.
-->
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:ext="http://jmix.io/schema/flowui/view-ext"
      extends="io/jmix/reportsflowui/view/report/report-detail-view.xml"
      messagesGroup="io.jmix.reportsflowui.view.report">
    <layout>
        <tabSheet id="mainTabSheet">
            <tab id="detailsTab">
                <vbox id="detailsTabContent">
                    <formLayout id="reportForm">
                        <!-- Сразу за «Группой»: домен читается как её деловая пара.
                             Поле — picker, а не выпадающий список: у областей есть поддомены,
                             и выбирать их удобнее по дереву справочника. -->
                        <entityPicker id="domainField"
                                      ext:index="3"
                                      label="msg://uz.kapitalbank.umida.view.reporting/reportDomain"
                                      metaClass="umida_ReportDomain"
                                      width="100%">
                            <actions>
                                <action id="lookup" type="entity_lookup"/>
                                <action id="clear" type="entity_clear"/>
                            </actions>
                        </entityPicker>
                    </formLayout>
                </vbox>
            </tab>
        </tabSheet>
    </layout>
</view>
