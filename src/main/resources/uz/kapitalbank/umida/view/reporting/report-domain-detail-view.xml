<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://reportDomainDetailView.title"
      focusComponent="form">
    <data>
        <instance id="reportDomainDc" class="uz.kapitalbank.umida.entity.ReportDomain">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name"/>
                <property name="businessOwner" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="reportDomainDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout expand="formScroller" height="100%" spacing="false">
        <scroller id="formScroller" width="100%" minHeight="0">
            <formLayout id="form" dataContainer="reportDomainDc">
                <responsiveSteps>
                    <responsiveStep minWidth="0" columns="1"/>
                    <responsiveStep minWidth="40em" columns="2"/>
                </responsiveSteps>
                <textField id="codeField" property="code" required="true"/>
                <!-- Родитель выбирается из того же справочника: пусто — область верхнего уровня. -->
                <entityPicker id="parentField" property="parent">
                    <actions>
                        <action id="lookup" type="entity_lookup"/>
                        <action id="clear" type="entity_clear"/>
                    </actions>
                </entityPicker>
                <textField id="shortNameField" property="shortName"/>
                <textField id="longNameField" property="longName"/>
                <entityPicker id="businessOwnerField" property="businessOwner">
                    <actions>
                        <action id="lookup" type="entity_lookup"/>
                        <action id="clear" type="entity_clear"/>
                    </actions>
                </entityPicker>
                <!-- Значения языка задаются контроллером: это коды локалей приложения. -->
                <select id="languageField" property="language" emptySelectionAllowed="true"/>
            </formLayout>
        </scroller>
        <hbox id="detailActions" padding="false">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
