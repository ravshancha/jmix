<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://reportDomainListView.title"
      focusComponent="reportDomainsTreeDataGrid">
    <data>
        <collection id="reportDomainsDc" class="uz.kapitalbank.umida.entity.ReportDomain">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name"/>
                <property name="businessOwner" fetchPlan="_instance_name"/>
            </fetchPlan>
            <!-- Дерево собирается в памяти по ссылке на родителя, поэтому уровни не
                 догружаются по одному: выбираются все области сразу, страниц нет. -->
            <loader id="reportDomainsDl">
                <query>
                    <![CDATA[select e from umida_ReportDomain e order by e.shortName, e.code]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <!-- Поддомены показываются внутри своей области, а не отдельными строками: выбирать
             домен отчёта удобнее по дереву. -->
        <treeDataGrid id="reportDomainsTreeDataGrid"
                      width="100%"
                      minHeight="20em"
                      dataContainer="reportDomainsDc"
                      hierarchyProperty="parent"
                      columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="shortName"/>
                <column property="code" width="12em" flexGrow="0"/>
                <column property="longName"/>
                <column property="businessOwner" width="18em"/>
                <column property="language" width="8em" flexGrow="0"/>
            </columns>
        </treeDataGrid>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="reportDomainsTreeDataGrid.createAction"/>
            <button id="editButton" action="reportDomainsTreeDataGrid.editAction"/>
            <button id="removeButton" action="reportDomainsTreeDataGrid.removeAction"/>
        </hbox>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
