<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Предметная область отчёта переехала из перечисления в справочник: у неё появились
         владелец от бизнеса, язык и вложенность. -->
    <changeSet id="1" author="umida">
        <createTable tableName="REPORT_DOMAIN">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_REPORT_DOMAIN"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="PARENT_ID" type="UUID"/>
            <column name="CODE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="SHORT_NAME" type="VARCHAR(150)"/>
            <column name="LONG_NAME" type="VARCHAR(500)"/>
            <column name="BUSINESS_OWNER_ID" type="UUID"/>
            <column name="LANGUAGE" type="VARCHAR(10)"/>
            <column name="CREATED_AT" type="${offsetDateTime.type}"/>
            <column name="UPDATED_AT" type="${offsetDateTime.type}"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="umida">
        <createIndex indexName="IDX_REPORT_DOMAIN_CODE" tableName="REPORT_DOMAIN" unique="true">
            <column name="CODE"/>
        </createIndex>
        <createIndex indexName="IDX_REPORT_DOMAIN_PARENT" tableName="REPORT_DOMAIN">
            <column name="PARENT_ID"/>
        </createIndex>
        <createIndex indexName="IDX_REPORT_DOMAIN_BUSINESS_OWNER" tableName="REPORT_DOMAIN">
            <column name="BUSINESS_OWNER_ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="3" author="umida">
        <addForeignKeyConstraint baseColumnNames="PARENT_ID" baseTableName="REPORT_DOMAIN"
                                 constraintName="FK_REPORT_DOMAIN_ON_PARENT"
                                 referencedColumnNames="ID" referencedTableName="REPORT_DOMAIN"/>
        <addForeignKeyConstraint baseColumnNames="BUSINESS_OWNER_ID" baseTableName="REPORT_DOMAIN"
                                 constraintName="FK_REPORT_DOMAIN_ON_BUSINESS_OWNER"
                                 referencedColumnNames="ID" referencedTableName="ORG_STRUCTURE_EMPLOYEE"/>
    </changeSet>

    <!-- Значения прежнего перечисления. Идентификаторы фиксированные: по ним строки
         сопоставляются со старой колонкой USER_REPORT.DOMAIN в changeSet 6. -->
    <changeSet id="4" author="umida">
        <insert tableName="REPORT_DOMAIN">
            <column name="ID" value="1f2a0001-0000-4000-8000-000000000001"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="CODE" value="RETAIL"/>
            <column name="SHORT_NAME" value="Retail"/>
            <column name="LONG_NAME" value="Retail business"/>
            <column name="LANGUAGE" value="en"/>
        </insert>
        <insert tableName="REPORT_DOMAIN">
            <column name="ID" value="1f2a0001-0000-4000-8000-000000000002"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="CODE" value="CORPORATE"/>
            <column name="SHORT_NAME" value="Corporate"/>
            <column name="LONG_NAME" value="Corporate business"/>
            <column name="LANGUAGE" value="en"/>
        </insert>
        <insert tableName="REPORT_DOMAIN">
            <column name="ID" value="1f2a0001-0000-4000-8000-000000000003"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="CODE" value="RISK"/>
            <column name="SHORT_NAME" value="Risk"/>
            <column name="LONG_NAME" value="Risk management"/>
            <column name="LANGUAGE" value="en"/>
        </insert>
        <insert tableName="REPORT_DOMAIN">
            <column name="ID" value="1f2a0001-0000-4000-8000-000000000004"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="CODE" value="FINANCE"/>
            <column name="SHORT_NAME" value="Finance"/>
            <column name="LONG_NAME" value="Finance"/>
            <column name="LANGUAGE" value="en"/>
        </insert>
        <insert tableName="REPORT_DOMAIN">
            <column name="ID" value="1f2a0001-0000-4000-8000-000000000005"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="CODE" value="OPERATIONS"/>
            <column name="SHORT_NAME" value="Operations"/>
            <column name="LONG_NAME" value="Operations"/>
            <column name="LANGUAGE" value="en"/>
        </insert>
        <insert tableName="REPORT_DOMAIN">
            <column name="ID" value="1f2a0001-0000-4000-8000-000000000006"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="CODE" value="HR"/>
            <column name="SHORT_NAME" value="HR"/>
            <column name="LONG_NAME" value="Human resources"/>
            <column name="LANGUAGE" value="en"/>
        </insert>
        <insert tableName="REPORT_DOMAIN">
            <column name="ID" value="1f2a0001-0000-4000-8000-000000000007"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="CODE" value="IT"/>
            <column name="SHORT_NAME" value="IT"/>
            <column name="LONG_NAME" value="Information technology"/>
            <column name="LANGUAGE" value="en"/>
        </insert>
        <insert tableName="REPORT_DOMAIN">
            <column name="ID" value="1f2a0001-0000-4000-8000-000000000008"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="CODE" value="OTHER"/>
            <column name="SHORT_NAME" value="Other"/>
            <column name="LONG_NAME" value="Other"/>
            <column name="LANGUAGE" value="en"/>
        </insert>
    </changeSet>

    <changeSet id="5" author="umida">
        <addColumn tableName="USER_REPORT">
            <column name="DOMAIN_ID" type="UUID"/>
        </addColumn>
        <createIndex indexName="IDX_USER_REPORT_DOMAIN" tableName="USER_REPORT">
            <column name="DOMAIN_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseColumnNames="DOMAIN_ID" baseTableName="USER_REPORT"
                                 constraintName="FK_USER_REPORT_ON_DOMAIN"
                                 referencedColumnNames="ID" referencedTableName="REPORT_DOMAIN"/>
    </changeSet>

    <!-- Проставленные домены переносятся на строки справочника по коду; колонка со строковым
         значением после этого не нужна. -->
    <changeSet id="6" author="umida">
        <sql>
            update USER_REPORT ur
            set DOMAIN_ID = (select rd.ID from REPORT_DOMAIN rd where rd.CODE = ur.DOMAIN)
            where ur.DOMAIN is not null
        </sql>
    </changeSet>

    <changeSet id="7" author="umida">
        <dropColumn tableName="USER_REPORT" columnName="DOMAIN"/>
    </changeSet>

</databaseChangeLog>
