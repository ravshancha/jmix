<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Доступ к отчёту, выданный подразделению целиком: отчёт запускают все его сотрудники. -->
    <changeSet id="1" author="umida">
        <createTable tableName="REPORT_SUBDIVISION_ACCESS">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" primaryKeyName="PK_REPORT_SUBDIVISION_ACCESS" nullable="false"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="REPORT_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="SUBDIVISION_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_FROM" type="DATE"/>
            <column name="VALID_TO" type="DATE"/>
            <column name="ACTIVE" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="GRANTED_BY_ID" type="${uuid.type}"/>
            <column name="GRANTED_AT" type="DATETIME"/>
            <column name="REVOKED_BY_ID" type="${uuid.type}"/>
            <column name="REVOKED_AT" type="DATETIME"/>
            <column name="REVOKE_REASON" type="VARCHAR(1000)"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="umida">
        <createIndex indexName="IDX_REPORT_SUBDIVISION_ACCESS_REPORT" tableName="REPORT_SUBDIVISION_ACCESS">
            <column name="REPORT_ID"/>
            <column name="SUBDIVISION_ID"/>
        </createIndex>
        <createIndex indexName="IDX_REPORT_SUBDIVISION_ACCESS_SUBDIVISION" tableName="REPORT_SUBDIVISION_ACCESS">
            <column name="SUBDIVISION_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseColumnNames="REPORT_ID" baseTableName="REPORT_SUBDIVISION_ACCESS"
                                 constraintName="FK_REPORT_SUBDIVISION_ACCESS_ON_REPORT" onDelete="CASCADE"
                                 referencedColumnNames="ID" referencedTableName="REPORT_REPORT"/>
        <addForeignKeyConstraint baseColumnNames="SUBDIVISION_ID" baseTableName="REPORT_SUBDIVISION_ACCESS"
                                 constraintName="FK_REPORT_SUBDIVISION_ACCESS_ON_SUBDIVISION" onDelete="CASCADE"
                                 referencedColumnNames="ID" referencedTableName="ORG_STRUCTURE_SUBDIVISION"/>
        <addForeignKeyConstraint baseColumnNames="GRANTED_BY_ID" baseTableName="REPORT_SUBDIVISION_ACCESS"
                                 constraintName="FK_REPORT_SUBDIVISION_ACCESS_ON_GRANTED_BY"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_USER"/>
        <addForeignKeyConstraint baseColumnNames="REVOKED_BY_ID" baseTableName="REPORT_SUBDIVISION_ACCESS"
                                 constraintName="FK_REPORT_SUBDIVISION_ACCESS_ON_REVOKED_BY"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_USER"/>
    </changeSet>

    <!-- Журнал: событие по доступу подразделения ссылается на подразделение, а не на сотрудника. -->
    <changeSet id="3" author="umida">
        <addColumn tableName="REPORT_ACCESS_EVENT">
            <column name="SUBDIVISION_ID" type="VARCHAR(36)"/>
        </addColumn>
        <addForeignKeyConstraint baseColumnNames="SUBDIVISION_ID" baseTableName="REPORT_ACCESS_EVENT"
                                 constraintName="FK_REPORT_ACCESS_EVENT_ON_SUBDIVISION" onDelete="CASCADE"
                                 referencedColumnNames="ID" referencedTableName="ORG_STRUCTURE_SUBDIVISION"/>
    </changeSet>

    <!-- Подразделение-владелец области — отдельная связь от подразделения-владельца отчёта. -->
    <changeSet id="4" author="umida">
        <addColumn tableName="REPORT_DOMAIN">
            <column name="SUBDIVISION_ID" type="VARCHAR(36)"/>
        </addColumn>
        <createIndex indexName="IDX_REPORT_DOMAIN_SUBDIVISION" tableName="REPORT_DOMAIN">
            <column name="SUBDIVISION_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseColumnNames="SUBDIVISION_ID" baseTableName="REPORT_DOMAIN"
                                 constraintName="FK_REPORT_DOMAIN_ON_SUBDIVISION"
                                 referencedColumnNames="ID" referencedTableName="ORG_STRUCTURE_SUBDIVISION"/>
    </changeSet>

</databaseChangeLog>
