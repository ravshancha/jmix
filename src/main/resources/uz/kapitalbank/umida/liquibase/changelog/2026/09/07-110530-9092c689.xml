        <addForeignKeyConstraint baseColumnNames="REPORT_ID" baseTableName="REPORT_ACCESS"
                                 constraintName="FK_REPORT_ACCESS_ON_REPORT" referencedColumnNames="ID"
                                 referencedTableName="REPORT_REPORT"/>
    </changeSet>
    <changeSet id="9" author="umida">
        <addForeignKeyConstraint baseColumnNames="REPORT_ID" baseTableName="REPORT_ACCESS_REQUEST"
                                 constraintName="FK_REPORT_ACCESS_REQUEST_ON_REPORT" referencedColumnNames="ID"
                                 referencedTableName="REPORT_REPORT"/>
    </changeSet>
</databaseChangeLog>