<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="umida">
        <dropForeignKeyConstraint baseTableName="REPORT_ACCESS_EVENT"
                                  constraintName="FK_REPORT_ACCESS_EVENT_ON_REPORT"/>
    </changeSet>
    <changeSet id="2" author="umida">
        <dropForeignKeyConstraint baseTableName="REPORT_ACCESS_EVENT"
                                  constraintName="FK_REPORT_ACCESS_EVENT_ON_REQUEST"/>
    </changeSet>
    <changeSet id="3" author="umida">
        <dropForeignKeyConstraint baseTableName="REPORT_ACCESS" constraintName="FK_REPORT_ACCESS_ON_REPORT"/>
    </changeSet>
    <changeSet id="4" author="umida">
        <dropForeignKeyConstraint baseTableName="REPORT_ACCESS_REQUEST"
                                  constraintName="FK_REPORT_ACCESS_REQUEST_ON_REPORT"/>
    </changeSet>
