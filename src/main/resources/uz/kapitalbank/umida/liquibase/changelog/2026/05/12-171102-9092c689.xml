<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="umida">
        <dropForeignKeyConstraint baseTableName="audit_logged_attr" constraintName="fk_audit_logged_attr_entity"/>
    </changeSet>
    <changeSet id="2" author="umida">
        <createTable tableName="UMIDA_DEPARTMENT">
            <column name="ID" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_DEPARTMENT"/>
            </column>
            <column name="PID" type="BIGINT"/>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
        </createTable>
    </changeSet>
    <changeSet id="3" author="umida">
        <createTable tableName="UMIDA_DIVISION">
            <column name="ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_DIVISION"/>
            </column>
            <column name="PID" type="BIGINT"/>
            <column name="DEPARTMENT_ID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
        </createTable>
    </changeSet>
    <changeSet id="4" author="umida">
        <createTable tableName="UMIDA_EMPLOYEE">
            <column name="ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_EMPLOYEE"/>
            </column>
            <column name="DEPARTMENT_ID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DIVISION_ID" type="BIGINT"/>
            <column name="FIRST_NAME" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_NAME" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="MIDDLE_NAME" type="VARCHAR(120)"/>
            <column name="JOB_TITLE" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="EMAIL" type="VARCHAR(50)"/>
            <column name="PHONE" type="VARCHAR(100)"/>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
        </createTable>
    </changeSet>
    <changeSet id="5" author="umida">
        <createIndex indexName="IDX_UMIDA_DIVISION_DEPARTMENT" tableName="UMIDA_DIVISION">
            <column name="DEPARTMENT_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="DEPARTMENT_ID" baseTableName="UMIDA_DIVISION"
                                 constraintName="FK_UMIDA_DIVISION_ON_DEPARTMENT" referencedColumnNames="ID"
                                 referencedTableName="UMIDA_DEPARTMENT"/>
    </changeSet>
    <changeSet id="6" author="umida">
        <createIndex indexName="IDX_UMIDA_EMPLOYEE_DEPARTMENT" tableName="UMIDA_EMPLOYEE">
            <column name="DEPARTMENT_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="DEPARTMENT_ID" baseTableName="UMIDA_EMPLOYEE"
                                 constraintName="FK_UMIDA_EMPLOYEE_ON_DEPARTMENT" referencedColumnNames="ID"
                                 referencedTableName="UMIDA_DEPARTMENT"/>
    </changeSet>
    <changeSet id="7" author="umida">
        <createIndex indexName="IDX_UMIDA_EMPLOYEE_DIVISION" tableName="UMIDA_EMPLOYEE">
            <column name="DIVISION_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="DIVISION_ID" baseTableName="UMIDA_EMPLOYEE"
                                 constraintName="FK_UMIDA_EMPLOYEE_ON_DIVISION" referencedColumnNames="ID"
                                 referencedTableName="UMIDA_DIVISION"/>
    </changeSet>
    <changeSet id="8" author="umida">
        <dropUniqueConstraint constraintName="audit_logged_attr_uniq_name" tableName="audit_logged_attr"/>
    </changeSet>
    <changeSet id="9" author="umida">
        <dropUniqueConstraint constraintName="audit_logged_entity_name_key" tableName="audit_logged_entity"/>
    </changeSet>
    <changeSet id="10" author="umida">
        <dropTable cascadeConstraints="true" tableName="audit_entity_log"/>
    </changeSet>
    <changeSet id="11" author="umida">
        <dropTable cascadeConstraints="true" tableName="audit_entity_snapshot"/>
    </changeSet>
    <changeSet id="12" author="umida">
        <dropTable cascadeConstraints="true" tableName="audit_logged_attr"/>
    </changeSet>
    <changeSet id="13" author="umida">
        <dropTable cascadeConstraints="true" tableName="audit_logged_entity"/>
    </changeSet>
</databaseChangeLog>